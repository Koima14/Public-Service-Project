{
  "name": "public-service-request-system",
  "version": "1.0.0",
  "description": "eCitizen-Style Public Service Request & Infrastructure Resolution System for Kenya",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client"
  },
  "keywords": [
    "ecitizen",
    "public-service",
    "service-request",
    "kenya",
    "civic-tech",
    "sqlite",
    "react",
    "express"
  ],
  "author": "Angela Koima",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0"
  }
}
